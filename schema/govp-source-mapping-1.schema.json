{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govp.io/schema/source-mapping-1.schema.json",
  "title": "GOVP source mapping 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "fields"],
  "properties": {
    "schema": { "const": "org.govp.source-mapping/1" },
    "version": { "const": 1 },
    "fields": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceField", "targetField", "sourceType", "required"],
        "properties": {
          "sourceField": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" },
          "targetField": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" },
          "sourceType": { "enum": ["string", "number", "boolean", "timestamp", "digest"] },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
